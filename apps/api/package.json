{
  "name": "@sodiq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --path tsconfig.worker.json --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/database/cli.js migrate",
    "db:codegen": "kysely-codegen --dialect postgres --env-file ../../.env --url \"env(DATABASE_MIGRATION_URL)\" --date-parser string --exclude-pattern \"pgboss.*\" --out-file src/database/types.generated.ts",
    "openapi": "node dist/openapi/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "1.9.1",
    "@sodiq/shared": "workspace:*",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pg-boss": "12.36.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
