{
  "name": "@sodiq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --path tsconfig.worker.json --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "db:migrate": "node dist/database/cli.js migrate",
    "db:codegen": "kysely-codegen --dialect postgres --env-file ../../.env --url \"env(DATABASE_MIGRATION_URL)\" --date-parser string --exclude-pattern \"pgboss.*\" --out-file src/database/types.generated.ts",
    "openapi": "node dist/openapi/cli.js",
    "first-account": "node dist/modules/auth/cli.js first-account",
    "e2e:build": "tsc -p tsconfig.e2e.json",
    "e2e:server": "node dist-e2e/testing/e2e/server.js",
    "e2e:seed": "node dist-e2e/testing/e2e/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "1.9.1",
    "@sentry/node": "11.5.0",
    "@sodiq/shared": "workspace:*",
    "@sodiq/timetable-rules": "workspace:*",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pg-boss": "12.36.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
