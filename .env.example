# LOCAL DEVELOPMENT AND CI ONLY. NEVER USE THESE VALUES ON A SERVER.
#
# Copy this file to .env. The users and passwords are the public ones that
# db/setup/local.sql creates on your own machine. The users of a server are
# created with SQL (db/setup/server.sql, never in the provider's console) and
# their values are entered in the provider's dashboard, never in a file in
# this repository (docs/deploy.md).

# Optional. Where the API listens; these are the defaults. With another HOST or
# PORT, change the proxy address in apps/web/vite.config.ts too.
# HOST=127.0.0.1
# PORT=3000

# The API and the jobs worker connect as the application user.
DATABASE_URL=postgres://sodiq_app:sodiq_app_local@localhost:5432/sodiq_dev

# Encrypts the secrets of the second step of sign-in: 32 bytes in base64. This
# value is public and for this machine and CI only. A server gets its own random
# key (task 0.10), made with: openssl rand -base64 32
SECOND_STEP_KEY=c29kaXEtbG9jYWwtc2Vjb25kLXN0ZXAta2V5LTAwMDE=

# Migrations, type generation and the test databases use the migration user.
DATABASE_MIGRATION_URL=postgres://sodiq_migrator:sodiq_migrator_local@localhost:5432/sodiq_dev

# Set on a server only (render.yaml, docs/deploy.md); a laptop and CI leave them unset.
# TRUST_PROXY=1            behind Render's load balancer: the first hop's X-Forwarded-Proto is trusted
# WEB_FILES=apps/web/dist  the API serves the web app's built files on its own origin (from the repository root)
# SENTRY_DSN=              error reports of the API and the worker; unset: none
# SENTRY_ENVIRONMENT=test  named in each report
# VITE_SENTRY_DSN=         error reports of the web app, read at its build; unset: none
# VITE_SENTRY_ENVIRONMENT=test

# Photos (task 2.2c-2). On a server the owner sets the four R2 variables in the
# provider's dashboard; a laptop and CI leave them unset, and the photo routes
# then answer "photos are not configured yet".
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# A laptop only, never with the R2 variables: 1 keeps photos in memory until the API restarts.
# PHOTOS_IN_MEMORY=1
# The address of the web app in the links of the mails (task 2.3c-2); unset: http://localhost:5173.
# WEB_ORIGIN=http://localhost:5173
# A laptop or the browser tests only, never on a server: each mail is also written as a file here.
# Until go-live mails are only written to the API log (docs/decisions.md, answer 16).
# MAIL_OUTBOX_DIR=/tmp/sodiq-mail
