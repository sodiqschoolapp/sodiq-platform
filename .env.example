# LOCAL DEVELOPMENT AND CI ONLY. NEVER USE THESE VALUES ON A SERVER.
#
# Copy this file to .env. The users and passwords are the public ones that
# db/setup/local.sql creates on your own machine. The test and production
# values are created in task 0.10 and are entered in the provider's dashboard,
# never in a file in this repository.

# Optional. Where the API listens; these are the defaults. With another HOST or
# PORT, change the proxy address in apps/web/vite.config.ts too.
# HOST=127.0.0.1
# PORT=3000

# The API and the jobs worker connect as the application user.
DATABASE_URL=postgres://sodiq_app:sodiq_app_local@localhost:5432/sodiq_dev

# Encrypts the secrets of the second step of sign-in: 32 bytes in base64. This
# value is public and for this machine and CI only. A server gets its own random
# key (task 0.10), made with: openssl rand -base64 32
SECOND_STEP_KEY=c29kaXEtbG9jYWwtc2Vjb25kLXN0ZXAta2V5LTAwMDE=

# Migrations, type generation and the test databases use the migration user.
DATABASE_MIGRATION_URL=postgres://sodiq_migrator:sodiq_migrator_local@localhost:5432/sodiq_dev
