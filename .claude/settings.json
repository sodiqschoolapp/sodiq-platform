{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git push -u origin task/*)",
      "Bash(git push origin task/*)",
      "Bash(gh api repos/sodiqschoolapp/sodiq-platform/*)",
      "Bash(gh pr ready *)",
      "PowerShell(pnpm *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch *)",
      "PowerShell(git push -u origin task/*)",
      "PowerShell(git push origin task/*)",
      "PowerShell(gh api repos/sodiqschoolapp/sodiq-platform/*)",
      "PowerShell(gh pr ready *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm dlx *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm remove *)",
      "PowerShell(pnpm dlx *)",
      "Edit(/docs/spec/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
