{
  "name": "sodiq-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint eslint.config.js scripts && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @sodiq/web test:e2e",
    "db:migrate": "turbo run build --filter=@sodiq/api && pnpm --filter @sodiq/api db:migrate",
    "db:codegen": "pnpm --filter @sodiq/api db:codegen",
    "api:client": "turbo run build --filter=@sodiq/api && pnpm --filter @sodiq/api openapi && pnpm --filter @sodiq/web api:types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  }
}
